<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/options_area"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parent_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/drawable_option_zone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 첫째 줄 -->
        <!-- 버튼 8_1 -->
        <FrameLayout
            android:id="@+id/container_button8_1"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/drawable_rounded_rectangle15"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/container_button8_2"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:elevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/icon8_movie_color"
                    android:alpha="0.6"
                    android:layout_gravity="center"/>
            </LinearLayout>
        </FrameLayout>

        <!-- 버튼 8_2 -->
        <FrameLayout
            android:id="@+id/container_button8_2"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/drawable_rounded_rectangle15"
            app:layout_constraintStart_toEndOf="@id/container_button8_1"
            app:layout_constraintEnd_toStartOf="@id/container_button8_3"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_margin="10dp"
            android:elevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/icon8_history"
                    android:alpha="0.7"
                    android:layout_gravity="center"/>
            </LinearLayout>
        </FrameLayout>

        <!-- 버튼 8_3 -->
        <FrameLayout
            android:id="@+id/container_button8_3"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/drawable_rounded_rectangle15"
            app:layout_constraintStart_toEndOf="@id/container_button8_2"
            app:layout_constraintEnd_toStartOf="@id/container_button8_4"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_margin="10dp"
            android:elevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/icon8_cycle"
                    android:alpha="0.7"
                    android:layout_gravity="center"/>
            </LinearLayout>
        </FrameLayout>

        <!-- 버튼 8_4 -->
        <FrameLayout
            android:id="@+id/container_button8_4"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/drawable_rounded_rectangle15"
            app:layout_constraintStart_toEndOf="@id/container_button8_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:elevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/icon8_20mile_color"
                    android:alpha="0.7"
                    android:layout_gravity="center"/>
            </LinearLayout>
        </FrameLayout>

        <!-- 둘째 줄 -->
        <!-- 버튼 8_5 -->
        <FrameLayout
            android:id="@+id/container_button8_5"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/drawable_rounded_rectangle15"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/container_button8_1"
            app:layout_constraintEnd_toStartOf="@id/container_button8_6"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:elevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/icon8_tpicture_color2"
                    android:alpha="0.6"
                    android:layout_gravity="center"/>
            </LinearLayout>
        </FrameLayout>

        <!-- 버튼 8_6 -->
        <FrameLayout
            android:id="@+id/container_button8_6"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/drawable_rounded_rectangle15"
            app:layout_constraintStart_toEndOf="@id/container_button8_5"
            app:layout_constraintEnd_toStartOf="@id/container_button8_7"
            app:layout_constraintTop_toBottomOf="@id/container_button8_2"
            android:layout_margin="10dp"
            android:elevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/icon8_cafe_color_2"
                    android:alpha="0.8"
                    android:layout_gravity="center"/>
            </LinearLayout>
        </FrameLayout>

        <!-- 버튼 8_7 -->
        <FrameLayout
            android:id="@+id/container_button8_7"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/drawable_rounded_rectangle15"
            app:layout_constraintStart_toEndOf="@id/container_button8_6"
            app:layout_constraintEnd_toStartOf="@id/container_button8_8"
            app:layout_constraintTop_toBottomOf="@id/container_button8_3"
            android:layout_margin="10dp"
            android:elevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/icon8_winter_color"
                    android:alpha="0.6"
                    android:layout_gravity="center"/>
            </LinearLayout>
        </FrameLayout>

        <!-- 버튼 8_8 -->
        <FrameLayout
            android:id="@+id/container_button8_8"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/drawable_rounded_rectangle15"
            app:layout_constraintStart_toEndOf="@id/container_button8_7"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/container_button8_4"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:elevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/icon8_leisure"
                    android:alpha="0.7"
                    android:layout_gravity="center"/>
            </LinearLayout>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
