<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="5dp">


    <TextView
        android:id="@+id/recommend_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:text="개발자 추천 테마"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:textStyle="bold"
        android:textSize="15dp"/>

    <ImageView
        android:layout_width="21dp"
        android:layout_height="21dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/recommend_text"
        android:background="@drawable/ic_kira"
        android:layout_marginTop="10dp"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parent_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommend_text"
        app:layout_constraintBottom_toBottomOf="parent">


        <!-- 첫째 줄 -->
        <!-- 버튼 8_1 -->
        <FrameLayout
            android:id="@+id/container_button8_1"
            android:layout_width="70dp"
            android:layout_height="95dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/container_button8_2"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp">

            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/drawable_white_rectangle_15"
                android:layout_gravity="top"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/container_icon_1"
                    android:background="@drawable/ic_theme_hotplace_travel"/>

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="핫플레이스"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#555555"/>

        </FrameLayout>

        <!-- 버튼 8_2 -->
        <FrameLayout
            android:id="@+id/container_button8_2"
            android:layout_width="70dp"
            android:layout_height="95dp"
            app:layout_constraintStart_toEndOf="@id/container_button8_1"
            app:layout_constraintEnd_toStartOf="@id/container_button8_3"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_margin="10dp"
            android:elevation="5dp">

            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/drawable_white_rectangle_15"
                android:layout_gravity="top"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/container_icon_2"
                    android:background="@drawable/ic_theme_historical_travel"/>

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="역사적장소"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#555555"/>

        </FrameLayout>

        <!-- 버튼 8_3 -->
        <FrameLayout
            android:id="@+id/container_button8_3"
            android:layout_width="70dp"
            android:layout_height="95dp"
            app:layout_constraintStart_toEndOf="@id/container_button8_2"
            app:layout_constraintEnd_toStartOf="@id/container_button8_4"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_margin="10dp"
            android:elevation="5dp">

            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/drawable_white_rectangle_15"
                android:layout_gravity="top"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/container_icon_3"
                    android:background="@drawable/ic_theme_cycle_travel"/>

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="자전거여행"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#555555"/>
        </FrameLayout>

        <!-- 버튼 8_4 -->
        <FrameLayout
            android:id="@+id/container_button8_4"
            android:layout_width="70dp"
            android:layout_height="95dp"
            app:layout_constraintStart_toEndOf="@id/container_button8_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:elevation="5dp">

            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/drawable_white_rectangle_15"
                android:layout_gravity="top"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/container_icon_4"
                    android:background="@drawable/ic_theme_20miles_travel"/>

            </androidx.cardview.widget.CardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20마일"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#555555"/>
        </FrameLayout>

        <!-- 둘째 줄 -->
        <!-- 버튼 8_5 -->
        <FrameLayout
            android:id="@+id/container_button8_5"
            android:layout_width="70dp"
            android:layout_height="95dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/container_button8_1"
            app:layout_constraintEnd_toStartOf="@id/container_button8_6"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:elevation="5dp">

            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/drawable_white_rectangle_15"
                android:layout_gravity="top"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/container_icon_5"
                    android:background="@drawable/ic_theme_photographer"/>

            </androidx.cardview.widget.CardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="인생짤 명소"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#555555"/>
        </FrameLayout>

        <!-- 버튼 8_6 -->
        <FrameLayout
            android:id="@+id/container_button8_6"
            android:layout_width="70dp"
            android:layout_height="95dp"
            app:layout_constraintStart_toEndOf="@id/container_button8_5"
            app:layout_constraintEnd_toStartOf="@id/container_button8_7"
            app:layout_constraintTop_toBottomOf="@id/container_button8_2"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="5dp"
            android:layout_margin="10dp"
            android:elevation="5dp">

            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/drawable_white_rectangle_15"
                android:layout_gravity="top"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/container_icon_6"
                    android:background="@drawable/ic_theme_coffee_travel"/>

            </androidx.cardview.widget.CardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="커피여행"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#555555"/>
        </FrameLayout>

        <!-- 버튼 8_7 -->
        <FrameLayout
            android:id="@+id/container_button8_7"
            android:layout_width="70dp"
            android:layout_height="95dp"
            app:layout_constraintStart_toEndOf="@id/container_button8_6"
            app:layout_constraintEnd_toStartOf="@id/container_button8_8"
            app:layout_constraintTop_toBottomOf="@id/container_button8_3"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="5dp"
            android:layout_margin="10dp"
            android:elevation="5dp">

            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/drawable_white_rectangle_15"
                android:layout_gravity="top"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/container_icon_7"
                    android:background="@drawable/ic_theme_winter_travel"/>

            </androidx.cardview.widget.CardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="겨울여행"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#555555"/>

        </FrameLayout>

        <!-- 버튼 8_8 -->
        <FrameLayout
            android:id="@+id/container_button8_8"
            android:layout_width="70dp"
            android:layout_height="95dp"
            app:layout_constraintStart_toEndOf="@id/container_button8_7"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/container_button8_4"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="5dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:elevation="5dp">

            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/drawable_white_rectangle_15"
                android:layout_gravity="top"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/container_icon_8"
                    android:background="@drawable/ic_theme_leisure_travel"/>

            </androidx.cardview.widget.CardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="레저/캠핑"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#555555"/>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
