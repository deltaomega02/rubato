<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trip_planner_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".TripPlanner1">

    <!-- 상단 검색 및 뒤로가기 영역 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="19dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/white"
        android:elevation="25dp"
        android:outlineSpotShadowColor="@android:color/transparent"
        android:outlineAmbientShadowColor="@android:color/transparent">



        <!-- 뒤로가기 버튼 -->
        <ImageView
            android:id="@+id/ic_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back_arrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:clickable="true"/>

        <!-- 검색 영역 (회색 사각형) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintStart_toEndOf="@id/ic_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/search_background"
                android:layout_width="match_parent"
                android:layout_marginStart="5dp"
                android:layout_height="45dp"
                android:scaleType="fitXY"
                android:src="@drawable/drawable_white_bordered_rectangle_100"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <EditText
                android:id="@+id/search_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="50dp"
                android:hint="어디로 떠나시나요?"
                android:textColor="#FF9A9A9A"
                android:textSize="15sp"
                android:layout_marginStart="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@null"/>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/drawable_shadow"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="0dp"
                android:elevation="5dp"
                android:layout_marginEnd="5dp">

                <ImageView
                    android:id="@+id/search_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_search"/>
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="500dp"
        android:layout_height="68dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/white"
        android:elevation="21dp"/>

    <!-- 지역리스트영역 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="70dp"
        app:layout_constraintTop_toBottomOf="@id/top_search"
        app:layout_constraintBottom_toTopOf="@id/selected_area"
        android:background="@color/white">

        <LinearLayout
            android:id="@+id/selected_area_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- 동적으로 추가될 지역 리스트 아이템들 -->

        </LinearLayout>
    </ScrollView>

    <!-- 구분선  -->
    <ImageView
        android:id="@+id/divider_line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:src="@drawable/drawable_black_divider"
        app:layout_constraintBottom_toTopOf="@+id/selected_area"
        android:layout_marginTop="3dp"
        android:alpha="0"/>

    <!--  사용자에게 팁 주는 공간  -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recomment_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/drawable_skyblue_rectangle_15"
        app:layout_constraintBottom_toTopOf="@+id/divider_line"
        app:layout_constraintStart_toStartOf="parent"
        android:elevation="5dp"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/recomment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="작성중이에요"
            android:textSize="14dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintStart_toEndOf="@+id/dot_loading_animation"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 도트 애니메이션 영역 -->
        <LinearLayout
            android:id="@+id/dot_loading_animation"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 애니메이션으로 사용할 도트들 -->
            <View
                android:id="@+id/dot1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_shape"
                android:layout_marginEnd="5dp" />

            <View
                android:id="@+id/dot2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_shape"
                android:layout_marginEnd="5dp" />

            <View
                android:id="@+id/dot3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_shape" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- 선택된 지역 영역 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selected_area"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/drawable_skyblue_rectangle_15"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <!-- 가로 스크롤 적용 -->
        <HorizontalScrollView
            android:id="@+id/horizon_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 선택한 지역리스트 -->
            <LinearLayout
                android:id="@+id/selected_regions_container"
                android:layout_width="wrap_content"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btn_selected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="82dp"
            android:layout_marginBottom="24dp"
            android:text="지역을 선택하세요"
            android:gravity="center"
            android:textStyle="bold"
            android:background="@drawable/drawable_white_rectangle_15"
            android:scaleType="centerCrop"
            android:elevation="5dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>



    <!-- 탑시트 레이아웃 변경 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/drawable_bottomsheet_rectangle_blue"
        android:elevation="20dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/top_search">

        <!-- ScrollView 추가 -->
        <ScrollView
            android:id="@+id/tag_scroll"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/drawable_bottomsheet_rectangle"
            android:elevation="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/sortarea">

            <!-- 체크박스 Flow -->
            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/checkbox_flow"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/drawable_blue_bar"
                />
        </ScrollView>

        <!-- 태그/테마로 정렬 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sortarea"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/drawable_white_rectangle_15"
            android:elevation="5dp"
            app:layout_constraintBottom_toTopOf="@id/preference_text">

            <TextView
                android:id="@+id/sorttext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:text="정렬기준"
                android:textSize="15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/sort_spinner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Spinner
                android:id="@+id/sort_spinner"
                android:layout_width="270dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 선호사항 선택 텍스트 -->
        <TextView
            android:id="@+id/preference_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="선호사항 선택"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sortarea" />

        <!-- 하늘색 바 -->
        <ImageView
            android:id="@+id/top_sheet_bar"
            android:layout_width="120dp"
            android:layout_height="11dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/drawable_white_rectangle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/preference_text"
            android:elevation="5dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>