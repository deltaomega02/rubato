<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/travelRouteDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_bar_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 뒤로 가기 버튼 -->
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_back_arrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- 상단부 로고 -->
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:background="@drawable/ic_rubato1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 상세 일정 텍스트 영역 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/travel_txt_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        android:layout_marginStart="25dp">

        <!-- 첫 번째 사각형 (~님이) -->
        <TextView
            android:id="@+id/name_area"
            android:layout_width="89dp"
            android:layout_height="40dp"
            android:background="@drawable/drawable_gray_rectangle"
            android:gravity="center"
            android:textColor="@color/black"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- "님의" 텍스트 -->
        <TextView
            android:id="@+id/name_area_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="님의"
            android:textStyle="bold"
            android:textColor="@color/darkgray"
            android:textSize="17dp"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@id/name_area"
            app:layout_constraintTop_toTopOf="@id/name_area"
            app:layout_constraintBottom_toBottomOf="@id/name_area" />

        <!-- 옵션 버튼 -->
        <ImageView
            android:id="@+id/btn_option"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_3_points"
            android:layout_marginEnd="13dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/name_area_txt"
            app:layout_constraintBottom_toBottomOf="@id/name_area_txt" />

        <!-- 두 번째 사각형 (~에서의) -->
        <TextView
            android:id="@+id/location_area"
            android:layout_width="89dp"
            android:layout_height="40dp"
            android:background="@drawable/drawable_gray_rectangle"
            android:gravity="center"
            android:textColor="@color/black"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/name_area"/>

        <!-- "에서의" 텍스트 -->
        <TextView
            android:id="@+id/location_area_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="에서의"
            android:textStyle="bold"
            android:textColor="@color/darkgray"
            android:textSize="17dp"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@id/location_area"
            app:layout_constraintTop_toTopOf="@id/location_area"
            app:layout_constraintBottom_toBottomOf="@id/location_area" />

        <!-- 세 번째 사각형 (~여정이에요) -->
        <TextView
            android:id="@+id/date_area"
            android:layout_width="89dp"
            android:layout_height="40dp"
            android:background="@drawable/drawable_gray_rectangle"
            android:gravity="center"
            android:textColor="@color/black"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@id/location_area_txt"
            app:layout_constraintTop_toTopOf="@id/location_area" />

        <!-- "여정이에요" 텍스트 -->
        <TextView
            android:id="@+id/date_area_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="여정이에요"
            android:textColor="@color/darkgray"
            android:textStyle="bold"
            android:textSize="17dp"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@id/date_area"
            app:layout_constraintTop_toTopOf="@id/date_area"
            app:layout_constraintBottom_toBottomOf="@id/date_area" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 지도 영역 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/map_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/travel_txt_container"
        app:layout_goneMarginTop="10dp">

        <ImageView
            android:id="@+id/map"
            android:layout_width="362dp"
            android:layout_height="190dp"
            android:src="@drawable/drawable_gray_rectangle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 상세 일정 -->
    <TextView
        android:id="@+id/day_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Day"
        android:textStyle="bold"
        android:textSize="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/map_area" />

    <TextView
        android:id="@+id/day_num_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="1"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/map_area" />

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="72dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="XX월.YY일"
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#808080"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/map_area" />

    <!-- 일정 계획 영역 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/plan_area"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/date">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp">

                <include layout="@layout/inc_plan_detail"/>
                <include layout="@layout/inc_plan_order"/>
                <include layout="@layout/inc_plan_detail"/>
                <include layout="@layout/inc_plan_order"/>
                <include layout="@layout/inc_plan_detail"/>

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 다음 일정 보기 버튼 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="700dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="15dp">

        <ImageView
            android:id="@+id/btn_next_bg"
            android:layout_width="362dp"
            android:layout_height="50dp"
            android:src="@drawable/drawable_skyblue_rectangle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btn_next_txt"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="다음 일정 보기"
            android:textColor="#FF000000"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
