<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:maxHeight="600dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_check_circle"
                android:tint="@color/mainColor"
                android:layout_gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="여행 계획 저장 완료!"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- 테마 & 태그 섹션 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/themeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="여행 테마: 관광지 중심"
                android:textSize="16sp"
                android:textColor="@color/mainColor"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp"
                android:layout_gravity="center"/>

            <!-- 태그 컨테이너 -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/tagContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@drawable/tag_container_background"
                app:flexWrap="wrap"
                app:justifyContent="center"
                app:alignItems="center"
                app:flexDirection="row"
                app:maxLine="2"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="12dp"
            android:maxHeight="200dp">

            <LinearLayout
                android:id="@+id/daysContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:background="@drawable/summary_background"
            android:padding="12dp">

            <TextView
                android:id="@+id/totalDistanceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="총 이동거리: 40.1km"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#424242"/>

            <TextView
                android:id="@+id/totalCostText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="총 예상비용: 79,000원"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#424242"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/confirmButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/confirm_button_background"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="확인"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.cardview.widget.CardView>