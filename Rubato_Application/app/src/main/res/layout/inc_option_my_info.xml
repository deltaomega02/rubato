<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- FrameLayout으로 그룹화된 사용자 정보 섹션 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/modifybutton"> <!-- signupbutton 위쪽에 배치 -->

            <!-- 사용자 이름 섹션 -->
            <FrameLayout
                android:id="@+id/my_name"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="top"
                android:visibility="visible">

                <TextView
                    android:id="@+id/user_name2"
                    android:layout_width="wrap_content"
                    android:layout_height="23dp"
                    android:layout_gravity="top|left"
                    android:layout_marginLeft="11dp"
                    android:layout_marginTop="4.5dp"
                    android:layout_marginBottom="-0.5dp"
                    android:gravity="left|center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="사용자 이름"
                    android:textColor="#FF000000"
                    android:textSize="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="left"
                    android:layout_marginLeft="11dp"
                    android:layout_marginTop="27.5dp"
                    android:layout_marginBottom="3.75dp"
                    android:gravity="left|center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="사용자명"
                    android:textColor="#FF666666"
                    android:textSize="12dp" />
            </FrameLayout>

            <!-- 계정 섹션 -->
            <FrameLayout
                android:id="@+id/my_email"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="top"
                android:layout_marginTop="47dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/user_email"
                    android:layout_width="wrap_content"
                    android:layout_height="23dp"
                    android:layout_gravity="top|left"
                    android:layout_marginLeft="11dp"
                    android:layout_marginTop="4.5dp"
                    android:layout_marginBottom="-0.5dp"
                    android:gravity="left|center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="계정"
                    android:textColor="#FF000000"
                    android:textSize="17dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="left"
                    android:layout_marginLeft="11dp"
                    android:layout_marginTop="27.5dp"
                    android:layout_marginBottom="3.75dp"
                    android:gravity="left|center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="계정"
                    android:textColor="#FF666666"
                    android:textSize="12dp" />

                <ImageView
                    android:id="@+id/divider_line"
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="20dp"
                    android:src="@drawable/drawable_divider"
                    app:layout_constraintBottom_toTopOf="@+id/name" />
            </FrameLayout>

            <!-- 추가 사용자 정보 섹션 1 -->
            <FrameLayout
                android:id="@+id/add_info"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="94dp"
                android:layout_marginBottom="94dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="20dp"
                    android:src="@drawable/drawable_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="23dp"
                    android:layout_gravity="top|left"
                    android:layout_marginLeft="11dp"
                    android:layout_marginTop="4.5dp"
                    android:layout_marginBottom="-0.5dp"
                    android:gravity="left|center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="추가 사용자 정보"
                    android:textColor="#FF000000"
                    android:textSize="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="left"
                    android:layout_marginLeft="11dp"
                    android:layout_marginTop="27.5dp"
                    android:layout_marginBottom="3.75dp"
                    android:gravity="left|center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="추가 사용자 정보"
                    android:textColor="#FF666666"
                    android:textSize="12dp" />
            </FrameLayout>

            <!-- 추가 사용자 정보 섹션 2 -->
            <FrameLayout
                android:id="@+id/add_info2"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="141dp"
                android:layout_marginBottom="47dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="20dp"
                    android:src="@drawable/drawable_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="23dp"
                    android:layout_gravity="top|left"
                    android:layout_marginLeft="11dp"
                    android:layout_marginTop="4.5dp"
                    android:layout_marginBottom="-0.5dp"
                    android:gravity="left|center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="추가 사용자 정보"
                    android:textColor="#FF000000"
                    android:textSize="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="left"
                    android:layout_marginLeft="11dp"
                    android:layout_marginTop="27.5dp"
                    android:layout_marginBottom="3.75dp"
                    android:gravity="left|center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="추가 사용자 정보"
                    android:textColor="#FF666666"
                    android:textSize="12dp" />
            </FrameLayout>

            <!-- 로그아웃 섹션 -->
            <FrameLayout
                android:id="@+id/logout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="188dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="20dp"
                    android:src="@drawable/drawable_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="23dp"
                    android:layout_gravity="left"
                    android:layout_marginLeft="11dp"
                    android:layout_marginTop="12.5dp"
                    android:layout_marginBottom="11.75dp"
                    android:gravity="left|center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="로그아웃"
                    android:textColor="#FF000000"
                    android:textSize="18dp" />
            </FrameLayout>
        </FrameLayout>

        <!-- 인증하기 버튼을 ConstraintLayout의 하단에 직접 배치 -->
        <android.widget.Button
            android:id="@+id/modifybutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_background"
            android:text="저장하기"
            android:textColor="#FF676767"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="24dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>